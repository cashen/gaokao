{
  "version": "V2.9.4.7.1",
  "policy": "性别不参与专业排除、不直接改变冲稳保，只影响提醒显著性；核心仍是孩子能力、家庭成本、地域偏好和学习方式适配。",
  "profile_fields": [
    {
      "id": "studentGender",
      "label": "学生性别",
      "options": [
        "unspecified",
        "male",
        "female"
      ],
      "default": "unspecified",
      "use": "只影响提醒优先级，不做专业好坏判断"
    },
    {
      "id": "codeAcceptance",
      "label": "代码接受度",
      "options": [
        "unknown",
        "high",
        "medium",
        "low"
      ],
      "default": "unknown"
    },
    {
      "id": "mathTolerance",
      "label": "数学承受度",
      "options": [
        "unknown",
        "high",
        "medium",
        "low"
      ],
      "default": "unknown"
    },
    {
      "id": "fieldWorkAcceptance",
      "label": "工程现场接受度",
      "options": [
        "unknown",
        "accept",
        "caution",
        "reject"
      ],
      "default": "unknown"
    },
    {
      "id": "gradWillingnessV29471",
      "label": "读研意愿",
      "options": [
        "unknown",
        "yes",
        "maybe",
        "no"
      ],
      "default": "unknown"
    }
  ],
  "rules": [
    {
      "rule_id": "CODE_INTENSITY",
      "priority": "high",
      "trigger_codes_prefix": [
        "0809"
      ],
      "trigger_keywords": [
        "计算机",
        "软件",
        "人工智能",
        "数据科学",
        "信息安全",
        "网络工程"
      ],
      "condition": {
        "codeAcceptance": [
          "low",
          "unknown"
        ],
        "mathTolerance": [
          "low",
          "unknown"
        ]
      },
      "message": "该方向通常需要代码接受度、数学逻辑和持续自学能力。若孩子排斥写代码，建议重点复核课程和培养方案。"
    },
    {
      "rule_id": "DATA_MANAGEMENT_NOT_CODE",
      "priority": "medium",
      "trigger_codes_prefix": [
        "1201"
      ],
      "trigger_keywords": [
        "大数据管理与应用",
        "信息管理与信息系统"
      ],
      "condition": {},
      "message": "该专业偏管理、业务和数据应用，不能简单按纯计算机/代码路线理解。"
    },
    {
      "rule_id": "ENGINEERING_SITE",
      "priority": "medium",
      "trigger_codes_prefix": [
        "0802",
        "0810",
        "0812",
        "0813",
        "0814",
        "0815",
        "0816",
        "0823",
        "0825"
      ],
      "trigger_keywords": [
        "机械",
        "土木",
        "测绘",
        "采矿",
        "化工",
        "材料",
        "交通",
        "建筑环境",
        "安全工程"
      ],
      "condition": {
        "fieldWorkAcceptance": [
          "caution",
          "reject",
          "unknown"
        ]
      },
      "message": "该方向可能涉及工程现场、实验、制造、施工或生产场景。建议结合孩子对现场环境和长期工科训练的接受度判断。"
    },
    {
      "rule_id": "MEDICAL_PATH",
      "priority": "medium",
      "trigger_codes_prefix": [
        "10"
      ],
      "trigger_keywords": [
        "医学",
        "临床",
        "口腔",
        "影像",
        "检验",
        "护理",
        "康复"
      ],
      "condition": {},
      "message": "医学相关专业需要区分医生路径、医学技术路径和护理康复路径；学习周期、资格要求和岗位形态不同。"
    },
    {
      "rule_id": "GRAD_DEPENDENCY",
      "priority": "medium",
      "trigger_codes_prefix": [
        "07",
        "0710",
        "0804",
        "0825",
        "0830"
      ],
      "trigger_keywords": [
        "数学",
        "物理",
        "化学",
        "生物",
        "材料",
        "环境"
      ],
      "condition": {
        "gradWillingnessV29471": [
          "no",
          "unknown"
        ]
      },
      "message": "部分基础理学、材料、生物、环境方向更依赖继续深造或行业周期。若不想读研，建议重点复核本科就业出口。"
    },
    {
      "rule_id": "TEACHER_EXAM_PATH",
      "priority": "low",
      "trigger_keywords": [
        "师范",
        "小学教育",
        "学前教育",
        "汉语言文学",
        "英语",
        "思想政治教育",
        "历史学"
      ],
      "condition": {},
      "message": "若家庭关注稳定或考编路径，需要核验是否为师范方向、教师资格路径和当地招聘学科需求。"
    },
    {
      "rule_id": "FEMALE_PRIORITY_NOTE",
      "priority": "info",
      "trigger_when_gender": "female",
      "condition": {},
      "message": "已选择“女孩”：系统不会按性别排除专业，只把学习方式、现场环境、长期培养和地域成本等提醒显示得更靠前。"
    },
    {
      "rule_id": "MALE_PRIORITY_NOTE",
      "priority": "info",
      "trigger_when_gender": "male",
      "condition": {},
      "message": "已选择“男孩”：系统不会按性别推荐专业，仍以孩子能力、成本和路径匹配为主。"
    }
  ]
}